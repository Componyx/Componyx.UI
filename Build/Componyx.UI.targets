<Project>

  <!-- Debug configuration gets the readable scripts and CSS, every other configuration gets the minified ones -->
  <PropertyGroup>
    <_ComponyxUIFlavor Condition="'$(Configuration)' == 'Debug'">debug</_ComponyxUIFlavor>
    <_ComponyxUIFlavor Condition="'$(_ComponyxUIFlavor)' == ''">release</_ComponyxUIFlavor>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Componyx.UI">
      <HintPath>$(MSBuildThisFileDirectory)..\$(_ComponyxUIFlavor)\net10.0\Componyx.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copy the type definitions and the VS Code custom data file into the project for editor IntelliSense (opt out with ComponyxUICopyTypes=false) -->
  <ItemGroup>
    <_ComponyxUITypes Include="$(MSBuildThisFileDirectory)..\types\**\*.d.ts" />
    <_ComponyxUIEditorData Include="$(MSBuildThisFileDirectory)..\editor\componyx.html-data.json" />
  </ItemGroup>

  <Target Name="ComponyxUICopyTypes" BeforeTargets="Build" Condition="'$(ComponyxUICopyTypes)' != 'false'">
    <Copy SourceFiles="@(_ComponyxUITypes)"
          DestinationFiles="@(_ComponyxUITypes->'$(MSBuildProjectDirectory)\TypeDefinitions\Componyx.UI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ComponyxUIEditorData)"
          DestinationFolder="$(MSBuildProjectDirectory)\TypeDefinitions\Componyx.UI"
          SkipUnchangedFiles="true" />
  </Target>

</Project>