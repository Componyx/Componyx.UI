<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Componyx.UI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <!-- Package metadata -->
  <PropertyGroup>
    <PackageId>Componyx.UI</PackageId>
    <Title>Componyx.UI</Title>
    <Version>1.0.6</Version>
    <Authors>E.H. Daanen</Authors>
    <Company>Componyx</Company>
    <Description>Standards-based, dependency-free UI components for the web, with built-in .NET integration.</Description>
    <PackageTags>ui;components;web-components;javascript;aspnetcore;forms</PackageTags>
    <RepositoryType>git</RepositoryType>
    <Copyright>(c) E.H. Daanen (Componyx)</Copyright>
    <PackageProjectUrl>https://componyx.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Componyx/Componyx.UI</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Logo-small.png</PackageIcon>
    <!-- The Debug and Release DLLs are packed manually below; build\Componyx.UI.targets picks one -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Componyx.Common" Version="1.0.3" />
  </ItemGroup>

  <!-- Embedded resources. The Link regex inserts "Resources\" after the component folder:
       ..\Resources\Button\CSS\Button.css becomes Button\Resources\CSS\Button.css -->
  <ItemGroup>
    <!-- Debug: readable scripts and styles -->
    <EmbeddedResource Condition="'$(Configuration)' == 'Debug'"
                      Include="..\Resources\**\*.js;..\Resources\**\*.css"
                      Exclude="..\Resources\**\*.min.js;..\Resources\**\*.min.css;..\Resources\ESM\**;..\Resources\Base\Script\UI.js;..\Resources\Base\Script\UIResourcePath.js;..\Resources\Base\Script\ResponsiveTemplates.js">
      <Link>$([System.Text.RegularExpressions.Regex]::Replace('%(RecursiveDir)', '^([^\\]+)\\', '$1\Resources\'))%(Filename)%(Extension)</Link>
    </EmbeddedResource>

    <!-- Every other configuration: minified scripts and styles -->
    <EmbeddedResource Condition="'$(Configuration)' != 'Debug'"
                      Include="..\Resources\**\*.min.js;..\Resources\**\*.min.css"
                      Exclude="..\Resources\ESM\**;..\Resources\Base\Script\UI.min.js">
      <Link>$([System.Text.RegularExpressions.Regex]::Replace('%(RecursiveDir)', '^([^\\]+)\\', '$1\Resources\'))%(Filename)%(Extension)</Link>
    </EmbeddedResource>

    <!-- ComponentIcons.css is also needed in non-Debug builds (Debug already gets it above) -->
    <EmbeddedResource Condition="'$(Configuration)' != 'Debug'" Include="..\Resources\Base\CSS\ComponentIcons.css">
      <Link>Base\Resources\CSS\ComponentIcons.css</Link>
    </EmbeddedResource>

    <!-- All configurations: fonts and data -->
    <EmbeddedResource Include="..\Resources\**\*.woff;..\Resources\**\Data\*.json"
                      Exclude="..\Resources\ESM\**">
      <Link>$([System.Text.RegularExpressions.Regex]::Replace('%(RecursiveDir)', '^([^\\]+)\\', '$1\Resources\'))%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Visible in the project, not built or packed -->
  <ItemGroup>
    <None Include="..\Resources\Base\Script\UIResourcePath.js">
      <Link>Base\Resources\Script\UIResourcePath.js</Link>
    </None>
    <None Include="..\NodeBackend\**\*.js">
      <Link>NodeBackend\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\TypeDefinitions\**\*.ts">
      <Link>TypeDefinitions\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- Package contents -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\Logo-small.png" Pack="true" PackagePath="\" />
    <None Include="..\build\Componyx.UI.targets" Pack="true" PackagePath="build\;buildTransitive\" />
    <None Include="..\componyx.html-data.json" Pack="true" PackagePath="editor\" />
    <None Update="..\TypeDefinitions\**\*.d.ts" Pack="true" PackagePath="types\%(RecursiveDir)" />

    <None Include="bin\Debug\$(TargetFramework)\Componyx.UI.dll" Pack="true" PackagePath="debug\$(TargetFramework)\" />
    <None Include="bin\Debug\$(TargetFramework)\Componyx.UI.xml" Pack="true" PackagePath="debug\$(TargetFramework)\" />
    <None Include="bin\Release\$(TargetFramework)\Componyx.UI.dll" Pack="true" PackagePath="release\$(TargetFramework)\" />
    <None Include="bin\Release\$(TargetFramework)\Componyx.UI.xml" Pack="true" PackagePath="release\$(TargetFramework)\" />
  </ItemGroup>

  <!-- Excluded from the package -->
  <ItemGroup>
    <None Remove="..\TypeDefinitions\ResponsiveTemplates.d.ts" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="node &quot;$(ProjectDir)\..\Build\build.js&quot;" />
  </Target>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="IF EXIST &quot;$(ProjectDir)\..\Data\Utils\AssemblyInfoUtil.exe&quot; &quot;$(ProjectDir)\..\Data\Utils\AssemblyInfoUtil.exe&quot; -inc:4 &quot;$(ProjectDir)\Properties\AssemblyInfo.cs&quot;" />
  </Target>

</Project>